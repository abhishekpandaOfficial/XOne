# Leave empty for local development. Vite proxies /api and /v1 to 127.0.0.1:8888.
VITE_XONE_API_BASE=

# For a hosted XOne web client, use the HTTPS origin of a separately deployed
# XOne backend, for example: https://api.xone.example
# Never put API keys or other secrets in VITE_* variables; Vite embeds them in
# the public browser bundle.
